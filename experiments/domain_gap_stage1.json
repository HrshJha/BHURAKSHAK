  "metadata": {
    "task": " ( domain-gap Stage 1: synthetic \u2192 synthetic)",
    "store": "data/features/features_v2.parquet",
    "alert_threshold_p_critical": 0.5,
    "axes": {
      "literal_synthetic_split": {
        "rule": "corpus-wide: top test_upper_fraction of event max_deformation held out",
        "config": {
          "test_upper_fraction": 0.2,
          "val_upper_fraction": 0.6
        },
        "degeneracy_note": "~75% of events carry \u22480 mm deformation (stable/vibration/fault families), so the held-out top band contains essentially all deforming events; the literal-axis model trains on no subsidence and cannot grade it. Reported as a real property of the generator, not hidden."
      },
      "family_conditional": {
        "rule": "within each scenario family: top 20% of max_deformation \u2192 test, next 20% \u2192 validation, rest \u2192 train; zero-variance families stay in train (no regime to hold out)",
        "zero_variance_families": [
          "E_stable_ground",
          "E_slow_drift_temperature",
          "E_sensor_bias",
          "E_sensor_stuck",
          "E_sensor_dropout",
          "E_sensor_spike",
          "E_sensor_drift",
          "E_packet_loss",
          "E_single_node_disturbance",
          "E_vibration_only",
          "E_communication_failure"
        ]
      }
    },
    "notes": [
      "Leakage assert on both axes: no event_id spans two regime bands.",
      "Test-band prevalence shifts with the axis \u2014 prevalence reported alongside PR-AUC so numbers cannot be read in isolation."
    ]
  },
